# Copy this file to `.env` and uncomment any line you want to override.
# `deploy.sh` sources `.env` (if it exists) before applying built-in defaults.
# Inline env vars on the command line (FOO=bar ./deploy.sh) only take effect
# for keys you have NOT uncommented here.

# Resource group and region
#LOCATION=eastus2
#RG=rg-omscs-eastus2

# VM identity and sizing.
# VM_NAME also seeds the NIC, NSG, public IP, and disk names.
#VM_NAME=omscs-dev-vm-eastus2
#VM_SIZE=Standard_B2s

# DNS label prepended to <region>.cloudapp.azure.com to form the FQDN.
# Required. Pick a value unique within the Azure region.
# Tip: this FQDN is publicly resolvable, and with SSH_SOURCE_ADDRESS_PREFIX="*"
# it's the only thing keeping the VM from being trivially discovered. Append a
# random suffix to keep it unguessable, e.g. `omscs-dev-vm-$(openssl rand -hex 4)`.
#DNS_LABEL=

# Public SSH key embedded in the VM's authorized_keys
#SSH_KEY=$HOME/.ssh/id_ed25519.pub

# Inbound source address prefix for host SSH (22) and container SSH ports.
# Lock to your IP for safety, e.g. 203.0.113.42/32. Use "*" for any source.
#SSH_SOURCE_ADDRESS_PREFIX="*"

# Daily auto-shutdown.
# TIME is HHmm 24-hour local time. TIME_ZONE is a Windows time-zone id (not IANA).
# EMAIL gets a 30-minute advance notice; leave empty for no email.
#AUTO_SHUTDOWN_ENABLED=true
#AUTO_SHUTDOWN_TIME=1900
#AUTO_SHUTDOWN_TIME_ZONE=UTC
#AUTO_SHUTDOWN_EMAIL=
